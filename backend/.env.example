# MongoDB connection string used by the API.
MONGODB_URI=mongodb://localhost:27017/incluwork

# Use a long, unique secret in every deployed environment. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Hosting providers normally inject PORT automatically.
PORT=3000

# Comma-separated list of allowed web origins. Leave unset to allow all origins.
CORS_ORIGIN=http://localhost:8081
